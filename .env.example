# CYBOT does not auto-load this file. Prefer Sprites connectors so model keys
# never land on the Sprite. Telegram is the only chat channel.

CYBOT_DATA_DIR=./data
CYBOT_HOST=0.0.0.0
CYBOT_PORT=8641
CYBOT_DEMO=0

# Optional Fernet key. If unset, CYBOT creates data/master.key mode 0600.
# CYBOT_MASTER_KEY=

# Required only for the HTTP MCP endpoint.
# CYBOT_MCP_TOKEN=

# Testing provider. OpenCode Go (subscription) or Zen (pay as you go).
# CYBOT_PROVIDER=opencode
# CYBOT_MODEL=deepseek-v4.1-flash
# OPENCODE_API_KEY=
# OPENCODE_PRODUCT=go
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# Used only when CYBOT_PROVIDER=auto.
# CYBOT_PROVIDER_ORDER=opencode,ollama,openrouter,anthropic,openai,gemini

# Telegram long-polling. Passive runs only, using the scope saved on the dashboard.
# TELEGRAM_BOT_TOKEN=

# ollama-local. The daemon should listen on localhost, not the public Sprite URL.
OLLAMA_HOST=http://127.0.0.1:11434

# Sprites gateway discovery. Answers from inside an authorized Sprite.
# SPRITES_GATEWAY_LIST=https://api.sprites.dev/v1/gateway/list

CYBOT_MAX_HOSTS=20
CYBOT_RATE_PER_MIN=20
CYBOT_RUN_TIMEOUT=120
CYBOT_MCP_STDIO=0
CYBOT_COOKIE_SECURE=0
